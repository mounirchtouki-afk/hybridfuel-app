{
  "name": "hybridfuel-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cross-env VITE_API_BASE=https://app.hybridfuelco.com vite build && cap sync",
    "cap:android": "cross-env VITE_API_BASE=https://app.hybridfuelco.com vite build && cap sync android && cap open android",
    "cap:ios": "cross-env VITE_API_BASE=https://app.hybridfuelco.com vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx-populate": "1.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "vite": "^5.4.0"
  }
}