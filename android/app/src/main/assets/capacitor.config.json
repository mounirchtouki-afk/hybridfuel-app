{
	"appId": "com.hybridfuelco.app",
	"appName": "HybridFuelCo",
	"webDir": "dist",
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
